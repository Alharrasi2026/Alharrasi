# ============================================================
# Al-Harrasi Ropes — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, add these under Project Settings → Environment Variables.
# ============================================================

# --- Database (auto-filled when you connect Vercel Postgres) ---
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# --- Blob storage (auto-filled when you connect Vercel Blob) ---
# BLOB_READ_WRITE_TOKEN=

# --- Admin session signing secret (generate any random 32+ character string) ---
AUTH_SECRET=change-this-to-a-long-random-string
