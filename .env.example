# ============================================================
# Al-Harrasi Ropes — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, add these under Project Settings → Environment Variables.
# ============================================================

# --- Database (auto-filled when you connect Vercel Postgres) ---
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# --- Blob storage (auto-filled when you connect Vercel Blob) ---
# BLOB_READ_WRITE_TOKEN=

# --- Admin session signing secret (generate any random long string) ---
AUTH_SECRET=change-this-to-a-long-random-string

# --- Email via Resend (https://resend.com — free tier is enough) ---
RESEND_API_KEY=
MAIL_FROM="Al-Harrasi Ropes <onboarding@resend.dev>"
MAIL_TO=Alharrasi.ropf@hotmail.com

# --- WhatsApp number (no + sign) ---
WA_PHONE=96890103771
